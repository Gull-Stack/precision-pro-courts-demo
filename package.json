{
  "name": "precision-pro-courts",
  "version": "1.0.0",
  "description": "Precision Pro Courts - Utah's Premier Sport Court Builder",
  "scripts": {
    "start": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "postbuild": "npm run minify:css && npm run minify:js",
    "minify:css": "cleancss -o _site/css/styles.css _site/css/styles.css || true",
    "minify:js": "terser _site/js/main.js -o _site/js/main.js -c -m || true && terser _site/js/chatbot.js -o _site/js/chatbot.js -c -m || true"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.31.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0"
  }
}
