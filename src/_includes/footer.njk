<!-- FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer-play">
      <div class="paint-court" id="paintCourt">
        <div class="paint-head">
          <h4>Paint Your Court</h4>
          <p>Tap a spot, then a color. Takes ten seconds.</p>
        </div>
        <svg class="paint-svg" viewBox="0 0 640 340" role="img" aria-label="Pickleball court you can color">
          <rect class="pc-surround" data-part="surround" x="0" y="0" width="640" height="340" rx="14" fill="#4A7B3F"/>
          <rect class="pc-court" data-part="play" x="100" y="70" width="150" height="200" fill="#1A3366"/>
          <rect class="pc-court" data-part="play" x="390" y="70" width="150" height="200" fill="#1A3366"/>
          <rect class="pc-kitchen" data-part="kitchen" x="250" y="70" width="140" height="200" fill="#3A6BB5"/>
          <g fill="none" stroke="#fff" stroke-width="3" pointer-events="none">
            <rect x="100" y="70" width="440" height="200"/>
            <line x1="250" y1="70" x2="250" y2="270"/><line x1="390" y1="70" x2="390" y2="270"/>
            <line x1="100" y1="170" x2="250" y2="170"/><line x1="390" y1="170" x2="540" y2="170"/>
          </g>
          <line x1="320" y1="58" x2="320" y2="282" stroke="#0a1628" stroke-width="5" stroke-linecap="round" pointer-events="none"/>
        </svg>
        <div class="paint-parts" role="group" aria-label="Part to paint">
          <button type="button" class="active" data-part="play">Court <span id="pcName-play">Competition Blue</span></button>
          <button type="button" data-part="kitchen">Kitchen <span id="pcName-kitchen">Light Blue</span></button>
          <button type="button" data-part="surround">Surround <span id="pcName-surround">Competition Green</span></button>
        </div>
        <div class="paint-swatches" id="paintSwatches" role="group" aria-label="Colors"></div>
        <div class="paint-actions">
          <button type="button" class="paint-shuffle" id="paintShuffle">Surprise me</button>
          <a href="{{ '/court-designer/' | url }}" class="paint-go" id="paintGo">Design it full size →</a>
        </div>
      </div>
      <div class="area-map">
        <h4>Where We Build</h4>
        <svg class="area-svg" viewBox="0 0 210 254" role="img" aria-label="Map of Utah and Las Vegas service areas">
          <path d="M44.6 7.9 H136.9 V47.6 H198.5 V206.4 H44.6 Z" class="am-state"/>
          <text x="150" y="140" class="am-label">UTAH</text>
          <text x="6" y="222" class="am-label">NV</text>
          {%- set pins = [
            {x: 108.6, y: 38.9, label: "Weber County", url: "/weber-county/"},
            {x: 111.1, y: 48.4, label: "Davis County", url: "/davis-county/"},
            {x: 111.1, y: 57.2, label: "Salt Lake County", url: "/salt-lake-county/"},
            {x: 118.2, y: 78.2, label: "Utah County", url: "/utah-county/"},
            {x: 112.6, y: 98.9, label: "Juab County", url: "/contact/#areas"},
            {x: 59.1, y: 202.5, label: "Washington County (St. George)", url: "/washington-county/"},
            {x: 11.1, y: 239.4, label: "Las Vegas", url: "/las-vegas/"}
          ] %}
          {%- for pin in pins %}
          <a href="{{ pin.url | url }}" class="am-pin" aria-label="{{ pin.label }}"><title>{{ pin.label }}</title><circle cx="{{ pin.x }}" cy="{{ pin.y }}" r="9" class="am-pulse" style="animation-delay: {{ loop.index0 * 0.35 }}s"/><circle cx="{{ pin.x }}" cy="{{ pin.y }}" r="4.5"/></a>
          {%- endfor %}
        </svg>
        <ul class="area-list">
          {% for area in site.serviceAreas %}
          <li><a href="{{ (area.url or '/contact/#areas') | url }}">{{ area.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="footer-grid">
      <div class="footer-col">
        <h4>{{ site.name }}</h4>
        <p>Utah's premier sport court construction and resurfacing company. Quality craftsmanship, honest pricing.</p>
        <p style="margin-top:0.75rem;font-size:0.85rem;opacity:0.85;">Certified and trained by Acrytech</p>
        {% if site.phone %}<p style="margin-top:1rem;"><a href="tel:{{ site.phoneTel or site.phone }}" class="footer-phone">{{ site.phone }}</a></p>{% endif %}
        <p style="margin-top:0.5rem;"><a href="mailto:{{ site.email }}" class="footer-email">{{ site.email }}</a></p>
        <p style="margin-top:0.5rem;">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="{{ '/services/pickleball/' | url }}">Pickleball Courts</a></li>
          <li><a href="{{ '/services/tennis/' | url }}">Tennis Courts</a></li>
          <li><a href="{{ '/services/basketball/' | url }}">Basketball Courts</a></li>
          <li><a href="{{ '/services/multi-sport/' | url }}">Multi-Sport Courts</a></li>
          <li><a href="{{ '/services/resurfacing/' | url }}">Resurfacing</a></li>
          <li><a href="{{ '/services/fencing/' | url }}">Court Fencing</a></li>
          <li><a href="{{ '/services/court-surfacing/' | url }}">Court Surfacing</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="{{ '/about/' | url }}">About Us</a></li>
          <li><a href="{{ '/gallery/' | url }}">Gallery</a></li>
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
          <li><a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></li>
          <li><a href="{{ '/terms-of-service/' | url }}">Terms of Service</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Partners</h4>
        <ul>
          <li><a href="https://bestsportssurfaces.com" target="_blank" rel="noopener">Best Sports Surfaces</a></li>
        </ul>
        <h4 style="margin-top:1rem;">Follow Us</h4>
        <div class="social-links">
          <a href="https://www.instagram.com/precisionpro.courts/" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com/precisionprocourts" target="_blank" rel="noopener" aria-label="Facebook" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-logo"><img src="{{ '/assets/images/logos/logo-white-lg.png' | url }}" alt="{{ site.name }}" style="height:25px;"></div>
      <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
      <p style="margin-top:0.4rem;font-size:0.8rem;opacity:0.9;">Recommended by <a href="https://bestsportssurfaces.com" target="_blank" rel="noopener" style="color:#fff;text-decoration:underline;">Best Sports Surfaces</a></p>
      <p style="margin-top:0.5rem;font-size:0.8rem;opacity:0.9;display:flex;align-items:center;justify-content:center;gap:6px;">Marketing by <a href="https://gullstack.com" target="_blank" rel="noopener" style="color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:6px;font-family:'Young Serif',Georgia,serif;font-weight:400;"><img src="https://gullstack.com/gull-logo.png" alt="" style="height:18px;width:auto;">GullStack</a></p>
    </div>
  </div>
</footer>
