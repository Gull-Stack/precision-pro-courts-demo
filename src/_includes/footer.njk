<!-- FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>{{ site.name }}</h4>
        <p>Utah's premier sport court construction and resurfacing company. Quality craftsmanship, honest pricing.</p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="{{ '/services/' | url }}#pickleball">Pickleball Courts</a></li>
          <li><a href="{{ '/services/' | url }}#tennis">Tennis Courts</a></li>
          <li><a href="{{ '/services/' | url }}#basketball">Basketball Courts</a></li>
          <li><a href="{{ '/services/' | url }}#resurfacing">Resurfacing</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="{{ '/about/' | url }}">About Us</a></li>
          <li><a href="{{ '/gallery/' | url }}">Gallery</a></li>
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
          <li><a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Service Areas</h4>
        <ul>
          {% for area in site.serviceAreas %}
          <li><a href="{{ '/contact/' | url }}#areas">{{ area }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-logo"><img src="{{ '/assets/images/logos/logo-white-lg.png' | url }}" alt="{{ site.name }}" style="height:25px;"></div>
      <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
      <p style="margin-top:0.5rem;font-size:0.8rem;opacity:0.7;">Marketing by <a href="https://gullstack.com" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">GullStack</a></p>
    </div>
  </div>
</footer>
