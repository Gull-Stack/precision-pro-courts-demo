<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  {% if site.gaId %}
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.gaId }}');
  </script>
  {% endif %}
  
  <title>{{ title | default(site.name + " | " + site.tagline) }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <meta name="author" content="{{ site.name }}">
  <meta name="geo.region" content="US-UT">
  
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon-16.png' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  <meta property="og:title" content="{{ ogTitle | default(title) | default(site.name) }}">
  <meta property="og:description" content="{{ ogDescription | default(description) | default(site.description) }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ '/assets/images/gallery/drone-aerial.jpg' | url }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default(site.name) }}">
  <meta name="twitter:description" content="{{ description | default(site.description) }}">
  
  {% block schema %}
  {%- set county = schemas.counties[page.url] -%}
  {%- set service = schemas.services[page.url] -%}
  {%- set faqList = schemas.faqs[page.url] -%}
  {%- set crumbs = schemas.breadcrumbs[page.url] -%}

  {%- if county %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": {{ (site.url + page.url + "#business") | dump | safe }},
    "name": {{ (site.name + " — " + county.name) | dump | safe }},
    "url": {{ (site.url + page.url) | dump | safe }},
    "parentOrganization": { "@id": {{ (site.url + "/#business") | dump | safe }} },
    "email": {{ site.email | dump | safe }},
    "image": {{ (site.url + site.image) | dump | safe }},
    "logo": {{ (site.url + site.logo) | dump | safe }},
    "priceRange": {{ site.priceRange | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "addressLocality": {{ county.locality | dump | safe }},
      "addressRegion": {{ county.region | dump | safe }},
      "addressCountry": {{ county.country | dump | safe }}
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ county.lat }},
      "longitude": {{ county.lng }}
    },
    "areaServed": { "@type": "AdministrativeArea", "name": {{ county.areaName | dump | safe }} },
    "sameAs": {{ site.social | dump | safe }},
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ site.rating.value | dump | safe }},
      "reviewCount": {{ site.rating.count | dump | safe }},
      "bestRating": {{ site.rating.best | dump | safe }},
      "worstRating": {{ site.rating.worst | dump | safe }}
    }
    {%- if site.phone %},
    "telephone": {{ site.phone | dump | safe }}
    {%- endif %}
  }
  </script>
  {%- else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": {{ (site.url + "/#business") | dump | safe }},
    "name": {{ site.name | dump | safe }},
    "url": {{ site.url | dump | safe }},
    "email": {{ site.email | dump | safe }},
    "image": {{ (site.url + site.image) | dump | safe }},
    "logo": {{ (site.url + site.logo) | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "priceRange": {{ site.priceRange | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "addressLocality": {{ site.address.city | dump | safe }},
      "addressRegion": {{ site.address.state | dump | safe }},
      "addressCountry": "US"
      {%- if site.address.street %},
      "streetAddress": {{ site.address.street | dump | safe }}
      {%- endif %}
      {%- if site.address.zip %},
      "postalCode": {{ site.address.zip | dump | safe }}
      {%- endif %}
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.latitude }},
      "longitude": {{ site.geo.longitude }}
    },
    "areaServed": [
      {%- for area in site.serviceAreas %}
      { "@type": "AdministrativeArea", "name": {{ area.name | dump | safe }} }{%- if not loop.last %},{% endif %}
      {%- endfor %}
    ],
    "sameAs": {{ site.social | dump | safe }},
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ site.rating.value | dump | safe }},
      "reviewCount": {{ site.rating.count | dump | safe }},
      "bestRating": {{ site.rating.best | dump | safe }},
      "worstRating": {{ site.rating.worst | dump | safe }}
    }
    {%- if site.phone %},
    "telephone": {{ site.phone | dump | safe }}
    {%- endif %}
  }
  </script>
  {%- endif %}

  {%- if crumbs %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {%- for crumb in crumbs %}
      { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ crumb.name | dump | safe }}, "item": {{ (site.url + crumb.url) | dump | safe }} }{%- if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {%- endif %}

  {%- if service %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": {{ service.serviceType | dump | safe }},
    "name": {{ service.name | dump | safe }},
    "provider": { "@id": {{ (site.url + "/#business") | dump | safe }} },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Utah" },
      { "@type": "AdministrativeArea", "name": "Clark County, NV" }
    ],
    "description": {{ service.description | dump | safe }},
    "url": {{ (site.url + page.url) | dump | safe }}
  }
  </script>
  {%- endif %}

  {%- if faqList %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in faqList %}
      {
        "@type": "Question",
        "name": {{ item.q | dump | safe }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
      }{%- if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {%- endif %}
  {% endblock %}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicons/favicon.svg' | url }}">
  <link rel="manifest" href="{{ '/assets/favicons/site.webmanifest' | url }}">
  <meta name="theme-color" content="#1e40af">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
</head>
<body>

  {% include "header.njk" %}

  {% block content %}
  {{ content | safe }}
  {% endblock %}

  {% include "footer.njk" %}

  <!-- STICKY CTA -->
  <!-- sticky CTA removed -->
  <div class="sticky-cta" id="stickyCta" style="display:none">
    <div class="sticky-cta-inner">
      <div class="sticky-cta-text">Free Court Consultation <span>— No obligation, expert advice</span></div>
      <a href="{{ '/contact/' | url }}" class="sticky-cta-btn">Get Quote</a>
    </div>
  </div>

  <script src="{{ '/js/main.js' | url }}"></script>
  
  <!-- PODIUM WIDGET -->
  <script>
    (function(w,d,l,t){
        try {
            var h = d.getElementsByTagName("head")[0];
            var s = d.createElement("script");
            s.id = "podium-widget";
            s.defer = true;
            s.async = true;
            s.setAttribute('data-organization-api-token', t);
            s.setAttribute("src", l);
            h.appendChild(s);
        } catch (e) {}
    })(window, document, "https://connect.podium.com/widget.js", "ca776e02-9895-4cf8-ba9a-e28463c53105");
  </script>
  <script src="/js/ga4-events.js"></script>
</body>
</html>
