---
layout: base.njk
title: "Free Court Estimate | Precision Pro Courts"
description: "Request a free court estimate today. New sport court construction, resurfacing & repairs. Serving Park City, Bountiful, Ogden, Lehi & communities throughout Utah. Fast response guaranteed."
permalink: /contact/
---

  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Ready to build your dream court? Get a free, no-obligation quote today.</p>
      <div class="breadcrumb"><a href="{{ '/' | url }}">Home</a> / Contact</div>
    </div>
  </section>

  <section class="contact-section" style="padding:5rem 0;">
    <div class="container">
      <div class="contact-grid">
        <div>
          <h2 style="font-size:2rem;margin-bottom:0.5rem;">Get Your Free Quote</h2>
          <p style="color:var(--gray-600);margin-bottom:2rem;">Fill out the form below and we'll get back to you within 24 hours with a detailed estimate.</p>
          <form class="contact-form" id="contactForm">
            <!-- Honeypot -->
            <input type="text" name="fax_number" id="fax_number" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;height:0;width:0">
            <!-- Timestamp token (bot detection) -->
            <input type="hidden" name="_timestamp" id="_timestamp" value="">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name *</label>
                <input type="text" id="name" name="name" required>
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="phone">Phone</label>
                <input type="tel" id="phone" name="phone">
              </div>
              <div class="form-group">
                <label for="service">Service Needed</label>
                <select id="service" name="service">
                  <option value="">Select a service...</option>
                  <option value="pickleball">Pickleball Court</option>
                  <option value="tennis">Tennis Court</option>
                  <option value="basketball">Basketball Court</option>
                  <option value="multi-sport">Multi-Sport Court</option>
                  <option value="resurfacing">Court Resurfacing</option>
                  <option value="other">Other / Not Sure</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label for="message">Tell Us About Your Project</label>
              <textarea id="message" name="message" placeholder="Describe your ideal court, space dimensions, timeline, etc."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" id="submitBtn" style="align-self:flex-start;">Send Message →</button>
            <div id="formStatus" style="display:none;padding:1rem;border-radius:8px;margin-top:1rem;"></div>
          </form>
          <script>
            document.getElementById('_timestamp').value = Date.now();
            document.getElementById('contactForm').addEventListener('submit', async function(e) {
              e.preventDefault();
              const btn = document.getElementById('submitBtn');
              const status = document.getElementById('formStatus');
              btn.disabled = true;
              btn.textContent = 'Sending...';
              status.style.display = 'none';
              const formData = {
                name: this.name.value,
                email: this.email.value,
                phone: this.phone.value,
                service: this.service.value,
                message: this.message.value,
                fax_number: this.fax_number.value,
                _timestamp: this._timestamp.value
              };
              try {
                const res = await fetch('/api/contact', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(formData)
                });
                const data = await res.json();
                if (res.ok) {
                  status.style.background = '#dcfce7';
                  status.style.color = '#166534';
                  status.textContent = '✓ Message sent! We\'ll be in touch soon.';
                  this.reset();
                  document.getElementById('_timestamp').value = Date.now();
                } else {
                  throw new Error(data.error || 'Failed to send');
                }
              } catch (err) {
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.textContent = '✗ Something went wrong. Please email us directly.';
              }
              status.style.display = 'block';
              btn.disabled = false;
              btn.textContent = 'Send Message →';
            });
          </script>
        </div>

        <div class="contact-info-sidebar">
          <h3>Get In Touch</h3>
          <div class="contact-info-item">
            <div class="icon">📧</div>
            <div>
              <h4>Email</h4>
              <a href="mailto:precisionprocourts@gmail.com">precisionprocourts@gmail.com</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="icon">🌐</div>
            <div>
              <h4>Website</h4>
              <a href="https://precisionprocourts.com" target="_blank">precisionprocourts.com</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="icon">⏱️</div>
            <div>
              <h4>Response Time</h4>
              <p>We typically respond within 24 hours</p>
            </div>
          </div>

          <div class="service-areas-map" id="areas">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1553060.0!2d-112.5!3d40.2!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87523d9488d131ed%3A0x5b53b7a0484d31ca!2sUtah!5e0!3m2!1sen!2sus!4v1" allowfullscreen="" loading="lazy" title="Precision Pro Courts Service Areas - Utah"></iframe>
          </div>

          <div style="margin-top:2rem;">
            <h4 style="margin-bottom:1rem;font-size:1.1rem;">Service Areas</h4>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Utah County</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Salt Lake County</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Davis County</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Weber County</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Juab County</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;color:var(--gray-600);">📍 Washington County</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container text-center">
      <span class="section-label fade-up">FAQ</span>
      <h2 class="section-title fade-up">Common Questions</h2>
    </div>
    <div class="container">
      <div class="faq-list">
        <div class="faq-item fade-up">
          <button class="faq-q">How long does it take to build a sport court?</button>
          <div class="faq-a"><p>Most residential courts take 2-4 weeks from start to finish, depending on size and complexity.</p></div>
        </div>
        <div class="faq-item fade-up">
          <button class="faq-q">How much does a sport court cost?</button>
          <div class="faq-a"><p>Costs vary based on court type, size, and features. Contact us for a free, no-obligation quote tailored to your project.</p></div>
        </div>
        <div class="faq-item fade-up">
          <button class="faq-q">Do you offer court resurfacing?</button>
          <div class="faq-a"><p>Yes! We specialize in resurfacing existing tennis, basketball, and pickleball courts to like-new condition.</p></div>
        </div>
        <div class="faq-item fade-up">
          <button class="faq-q">Can I customize my court colors and design?</button>
          <div class="faq-a"><p>Absolutely! We offer full customization including colors, logos, line markings, and multi-sport configurations.</p></div>
        </div>
        <div class="faq-item fade-up">
          <button class="faq-q">Do I need a permit to build a sport court?</button>
          <div class="faq-a"><p>Permit requirements vary by city and county. We handle the entire permitting process for you.</p></div>
        </div>
      </div>
    </div>
  </section>

<!-- Footer handled by base.njk -->
