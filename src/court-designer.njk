<script>
    // Player's Choice Colors only (from old site)
    const COURT_COLORS = [
        // Row 1 - Greens & Tan  
        { name: 'Comp Green', hex: '#38613b' },
        { name: 'Forest Green', hex: '#355E3B' },
        { name: 'Dark Forest Green', hex: '#2F4F2F' },
        { name: 'Khaki', hex: '#c4b68a' },
        // Row 2 - Grays & Navy
        { name: 'Dark Gray', hex: '#4b4d4c' },
        { name: 'Medium Gray', hex: '#a1a1aa' },
        { name: 'Navy Blue', hex: '#1a3366' },
        { name: 'Dark Blue', hex: '#2d4470' },
        // Row 3 - Blues & Browns
        { name: 'Blue', hex: '#3b7dbc' },
        { name: 'Light Blue', hex: '#6eb5e0' },
        { name: 'Brown', hex: '#6b5e41' },
        { name: 'Sand', hex: '#c4a76c' },
        // Row 4 - Reds, Orange & White
        { name: 'Rust', hex: '#d17b45' },
        { name: 'Crimson', hex: '#8b3534' },
        { name: 'Orange', hex: '#e07b30' },
        { name: 'White', hex: '#ffffff' },
    ];
    
    const PRESETS = {
        classic: { play: '#3b7dbc', kitchen: '#3b7dbc', surround: '#38613b', line: '#ffffff', bballLine: '#a1a1aa', playName: 'Blue', kitchenName: 'Blue', surroundName: 'Comp Green', bballLineName: 'Medium Gray' },
        forest: { play: '#355E3B', kitchen: '#355E3B', surround: '#2F4F2F', line: '#ffffff', bballLine: '#a1a1aa', playName: 'Forest Green', kitchenName: 'Forest Green', surroundName: 'Dark Forest Green', bballLineName: 'Medium Gray' },
        lightblue: { play: '#6eb5e0', kitchen: '#6eb5e0', surround: '#a1a1aa', line: '#ffffff', bballLine: '#4b4d4c', playName: 'Light Blue', kitchenName: 'Light Blue', surroundName: 'Medium Gray', bballLineName: 'Dark Gray' },
        coastal: { play: '#1a3366', kitchen: '#6eb5e0', surround: '#38613b', line: '#ffffff', bballLine: '#a1a1aa', playName: 'Navy Blue', kitchenName: 'Light Blue', surroundName: 'Comp Green', bballLineName: 'Medium Gray' },
        popular: { play: '#3b7dbc', kitchen: '#3b7dbc', surround: '#4b4d4c', line: '#ffffff', bballLine: '#a1a1aa', playName: 'Blue', kitchenName: 'Blue', surroundName: 'Dark Gray', bballLineName: 'Medium Gray' },
    };
    
    const COURT_DIMS = {
        tennis: { courtW: 36, courtL: 78, totalW: 60, totalL: 120 },
        pickleball: { courtW: 20, courtL: 44, totalW: 34, totalL: 64 },
        basketball: { courtW: 50, courtL: 94, totalW: 60, totalL: 100 },
        multi: { courtW: 20, courtL: 44, totalW: 30, totalL: 50 }, // Pickleball + basketball overlay (tight fit, basketball centered)
    };
    
    let state = {
        sport: 'tennis',
        playColor: '#3b7dbc',
        kitchenColor: '#3b7dbc',
        surroundColor: '#38613b',
        lineColor: '#ffffff',
        bballLineColor: '#a1a1aa',
        activeColorTarget: null
    };
    
    const canvas = document.getElementById('courtCanvas');
    const ctx = canvas.getContext('2d');
    
    // Preload logo for watermark
    const logoImg = new Image();
    logoImg.src = '/assets/images/logos/logo-white-lg.png';
    logoImg.onload = () => drawCourt(); // Redraw when logo loads
    
    const paletteGrid = document.getElementById('paletteGrid');
    COURT_COLORS.forEach((color) => {
        const swatch = document.createElement('div');
        swatch.className = 'swatch';
        swatch.style.background = color.hex;
        swatch.title = color.name;
        swatch.dataset.hex = color.hex;
        swatch.dataset.name = color.name;
        swatch.addEventListener('click', () => selectColor(color.hex, color.name));
        paletteGrid.appendChild(swatch);
    });
    
    function setColorTarget(target) {
        state.activeColorTarget = target;
        document.querySelectorAll('.color-row').forEach(el => el.classList.remove('active'));
        document.getElementById(target + 'Row').classList.add('active');
        
        // Show palette when a color is selected
        document.getElementById('paletteSection').classList.add('show');
    }
    
    function updateColorRowVisibility() {
        const kitchenRow = document.getElementById('kitchenRow');
        const bballLineRow = document.getElementById('bballLineRow');
        
        // Kitchen shows for pickleball and multi-sport
        if (state.sport === 'pickleball' || state.sport === 'multi') {
            kitchenRow.classList.add('show');
        } else {
            kitchenRow.classList.remove('show');
            if (state.activeColorTarget === 'kitchen') {
                state.activeColorTarget = null;
                kitchenRow.classList.remove('active');
                document.getElementById('paletteSection').classList.remove('show');
            }
        }
        
        // Basketball lines only shows for multi-sport
        if (state.sport === 'multi') {
            bballLineRow.classList.add('show');
        } else {
            bballLineRow.classList.remove('show');
            if (state.activeColorTarget === 'bballLine') {
                state.activeColorTarget = null;
                bballLineRow.classList.remove('active');
                document.getElementById('paletteSection').classList.remove('show');
            }
        }
    }
    
    function selectColor(hex, name) {
        if (!state.activeColorTarget) return; // Don't do anything if no target selected
        
        if (state.activeColorTarget === 'play') {
            state.playColor = hex;
            document.getElementById('playColor').style.background = hex;
            document.getElementById('playColorName').textContent = name;
        } else if (state.activeColorTarget === 'kitchen') {
            state.kitchenColor = hex;
            document.getElementById('kitchenColor').style.background = hex;
            document.getElementById('kitchenColorName').textContent = name;
        } else if (state.activeColorTarget === 'surround') {
            state.surroundColor = hex;
            document.getElementById('surroundColor').style.background = hex;
            document.getElementById('surroundColorName').textContent = name;
        } else if (state.activeColorTarget === 'line') {
            state.lineColor = hex;
            document.getElementById('lineColor').style.background = hex;
            document.getElementById('lineColorName').textContent = name;
        } else if (state.activeColorTarget === 'bballLine') {
            state.bballLineColor = hex;
            document.getElementById('bballLineColor').style.background = hex;
            document.getElementById('bballLineColorName').textContent = name;
        }
        
        drawCourt();
    }
    
    document.querySelectorAll('.sport-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.sport-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.sport = btn.dataset.sport;
            updateColorRowVisibility();
            drawCourt();
        });
    });
    
    document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const preset = PRESETS[btn.dataset.preset];
            state.playColor = preset.play;
            state.kitchenColor = preset.kitchen;
            state.surroundColor = preset.surround;
            state.lineColor = preset.line;
            state.bballLineColor = preset.bballLine;
            document.getElementById('playColor').style.background = preset.play;
            document.getElementById('kitchenColor').style.background = preset.kitchen;
            document.getElementById('surroundColor').style.background = preset.surround;
            document.getElementById('lineColor').style.background = preset.line;
            document.getElementById('bballLineColor').style.background = preset.bballLine;
            document.getElementById('playColorName').textContent = preset.playName;
            document.getElementById('kitchenColorName').textContent = preset.kitchenName;
            document.getElementById('surroundColorName').textContent = preset.surroundName;
            document.getElementById('lineColorName').textContent = 'White';
            document.getElementById('bballLineColorName').textContent = preset.bballLineName;
            drawCourt();
        });
    });
    
    // Create export image with color swatches
    function createExportImage() {
        const exportCanvas = document.createElement('canvas');
        const exportCtx = exportCanvas.getContext('2d');
        
        // Make export canvas larger to accommodate color info
        const padding = 80;
        const swatchHeight = 120;
        exportCanvas.width = canvas.width + (padding * 2);
        exportCanvas.height = canvas.height + swatchHeight + (padding * 2);
        
        // White background
        exportCtx.fillStyle = '#ffffff';
        exportCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
        
        // Draw court centered
        exportCtx.drawImage(canvas, padding, padding);
        
        // Add color swatches at bottom
        const swatchY = canvas.height + padding + 20;
        const swatchSize = 40;
        const swatchSpacing = 120;
        let startX = (exportCanvas.width - (getActiveColors().length * swatchSpacing - 20)) / 2;
        
        exportCtx.font = 'bold 14px Inter, sans-serif';
        exportCtx.textAlign = 'center';
        
        getActiveColors().forEach((colorInfo, index) => {
            const x = startX + (index * swatchSpacing);
            
            // Draw swatch
            exportCtx.fillStyle = colorInfo.hex;
            exportCtx.fillRect(x, swatchY, swatchSize, swatchSize);
            exportCtx.strokeStyle = '#333333';
            exportCtx.lineWidth = 2;
            exportCtx.strokeRect(x, swatchY, swatchSize, swatchSize);
            
            // Draw label
            exportCtx.fillStyle = '#333333';
            exportCtx.fillText(colorInfo.label, x + swatchSize/2, swatchY + swatchSize + 18);
            exportCtx.fillText(colorInfo.name, x + swatchSize/2, swatchY + swatchSize + 35);
        });
        
        return exportCanvas;
    }
    
    // Get active colors based on sport
    function getActiveColors() {
        const colors = [
            { label: 'Playing', name: getColorName(state.playColor), hex: state.playColor },
            { label: 'Surround', name: getColorName(state.surroundColor), hex: state.surroundColor }
        ];
        
        if (state.sport === 'pickleball' || state.sport === 'multi') {
            colors.splice(1, 0, { label: 'Kitchen', name: getColorName(state.kitchenColor), hex: state.kitchenColor });
        }
        
        colors.push({ label: 'Lines', name: getColorName(state.lineColor), hex: state.lineColor });
        
        if (state.sport === 'multi') {
            colors.push({ label: 'B-Ball Lines', name: getColorName(state.bballLineColor), hex: state.bballLineColor });
        }
        
        return colors;
    }
    
    // Get color name from hex
    function getColorName(hex) {
        const found = COURT_COLORS.find(c => c.hex.toLowerCase() === hex.toLowerCase());
        return found ? found.name : 'Custom';
    }

    document.getElementById('downloadBtn').addEventListener('click', () => {
        const exportCanvas = createExportImage();
        const link = document.createElement('a');
        link.download = `precision-pro-courts-${state.sport}-design.png`;
        link.href = exportCanvas.toDataURL('image/png');
        link.click();
    });
    
    // Share button functionality
    document.getElementById('shareBtn').addEventListener('click', async () => {
        try {
            const exportCanvas = createExportImage();
            exportCanvas.toBlob(async (blob) => {
                const file = new File([blob], `precision-pro-courts-${state.sport}-design.png`, { type: 'image/png' });
                
                if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                    // Use native sharing if available (mobile)
                    await navigator.share({
                        title: 'My Custom Court Design',
                        text: `Check out my custom ${state.sport} court design from Precision Pro Courts!`,
                        files: [file]
                    });
                } else {
                    // Fallback: Copy image to clipboard
                    if (navigator.clipboard && window.ClipboardItem) {
                        const item = new ClipboardItem({ 'image/png': blob });
                        await navigator.clipboard.write([item]);
                        
                        // Show feedback
                        const shareBtn = document.getElementById('shareBtn');
                        const originalText = shareBtn.innerHTML;
                        shareBtn.innerHTML = '<span>✅</span> Copied!';
                        shareBtn.style.background = '#22c55e';
                        setTimeout(() => {
                            shareBtn.innerHTML = originalText;
                            shareBtn.style.background = '';
                        }, 2000);
                    } else {
                        // Final fallback: Download
                        const link = document.createElement('a');
                        link.download = `precision-pro-courts-${state.sport}-design.png`;
                        link.href = exportCanvas.toDataURL('image/png');
                        link.click();
                    }
                }
            }, 'image/png');
        } catch (error) {
            console.error('Share failed:', error);
            // Fallback to download
            const exportCanvas = createExportImage();
            const link = document.createElement('a');
            link.download = `precision-pro-courts-${state.sport}-design.png`;
            link.href = exportCanvas.toDataURL('image/png');
            link.click();
        }
    });
    
    function drawCourt() {
        const dims = COURT_DIMS[state.sport];
        
        // Fixed canvas size to fill the preview area consistently (2x size)
        const maxWidth = 700;
        const maxHeight = 900;
        
        // Calculate scale to fit court while maximizing space
        const scaleByWidth = maxWidth / dims.totalW;
        const scaleByHeight = maxHeight / dims.totalL;
        const scale = Math.min(scaleByWidth, scaleByHeight);
        
        // Size canvas to exactly fit the court (no extra padding)
        canvas.width = dims.totalW * scale;
        canvas.height = dims.totalL * scale;
        
        const offX = 0;
        const offY = 0;
        
        // Fill entire canvas with surround color - no dark blue background
        ctx.fillStyle = state.surroundColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Gritty texture on surround
        ctx.globalAlpha = 0.06;
        for (let i = 0; i < 800; i++) {
            ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
            const size = Math.random() > 0.7 ? 2 : 1;
            ctx.fillRect(Math.random() * canvas.width, Math.random() * canvas.height, size, size);
        }
        ctx.globalAlpha = 1;
        
        const courtOffX = offX + ((dims.totalW - dims.courtW) / 2) * scale;
        const courtOffY = offY + ((dims.totalL - dims.courtL) / 2) * scale;
        ctx.fillStyle = state.playColor;
        ctx.fillRect(courtOffX, courtOffY, dims.courtW * scale, dims.courtL * scale);
        
        // Enhanced gritty texture on court surface
        ctx.globalAlpha = 0.08;
        for (let i = 0; i < 600; i++) {
            ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
            const size = Math.random() > 0.8 ? 2 : 1;
            ctx.fillRect(courtOffX + Math.random() * dims.courtW * scale, courtOffY + Math.random() * dims.courtL * scale, size, size);
        }
        ctx.globalAlpha = 1;
        
        ctx.strokeStyle = state.lineColor;
        ctx.lineWidth = 5;
        ctx.lineCap = 'round';
        
        const cx = canvas.width / 2;
        const cy = canvas.height / 2;
        const hw = (dims.courtW * scale) / 2;
        const hl = (dims.courtL * scale) / 2;
        
        ctx.strokeRect(courtOffX, courtOffY, dims.courtW * scale, dims.courtL * scale);
        
        if (state.sport === 'tennis') {
            const singlesW = (27 * scale) / 2;
            const serviceDist = 21 * scale;
            ctx.beginPath();
            ctx.moveTo(cx - singlesW, cy - hl);
            ctx.lineTo(cx - singlesW, cy + hl);
            ctx.moveTo(cx + singlesW, cy - hl);
            ctx.lineTo(cx + singlesW, cy + hl);
            ctx.stroke();
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(cx - singlesW, cy - serviceDist);
            ctx.lineTo(cx + singlesW, cy - serviceDist);
            ctx.moveTo(cx - singlesW, cy + serviceDist);
            ctx.lineTo(cx + singlesW, cy + serviceDist);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - serviceDist);
            ctx.lineTo(cx, cy + serviceDist);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - hl);
            ctx.lineTo(cx, cy - hl + 8);
            ctx.moveTo(cx, cy + hl);
            ctx.lineTo(cx, cy + hl - 8);
            ctx.stroke();
        } else if (state.sport === 'pickleball') {
            const kitchen = 7 * scale;
            
            // Fill kitchen zones (non-volley zones) with kitchen color
            ctx.fillStyle = state.kitchenColor;
            ctx.fillRect(cx - hw, cy - kitchen, hw * 2, kitchen); // top kitchen
            ctx.fillRect(cx - hw, cy, hw * 2, kitchen); // bottom kitchen
            
            // Add gritty texture to kitchen
            ctx.globalAlpha = 0.08;
            for (let i = 0; i < 150; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
                const size = Math.random() > 0.8 ? 2 : 1;
                ctx.fillRect(cx - hw + Math.random() * hw * 2, cy - kitchen + Math.random() * kitchen, size, size);
                ctx.fillRect(cx - hw + Math.random() * hw * 2, cy + Math.random() * kitchen, size, size);
            }
            ctx.globalAlpha = 1;
            
            ctx.strokeStyle = state.lineColor;
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy - kitchen);
            ctx.lineTo(cx + hw, cy - kitchen);
            ctx.moveTo(cx - hw, cy + kitchen);
            ctx.lineTo(cx + hw, cy + kitchen);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - hl);
            ctx.lineTo(cx, cy - kitchen);
            ctx.moveTo(cx, cy + hl);
            ctx.lineTo(cx, cy + kitchen);
            ctx.stroke();
        } else if (state.sport === 'basketball') {
            // Center circle
            ctx.beginPath();
            ctx.arc(cx, cy, 6 * scale, 0, Math.PI * 2);
            ctx.stroke();
            
            // Half court line
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            
            const ftWidth = 6 * scale; // half of 12ft lane width
            const ftDepth = 19 * scale; // 19ft from baseline
            const basketDist = 5.25 * scale; // basket center from baseline
            const threeRadius = 23.75 * scale; // 3pt arc radius
            const threeCornerDist = 3 * scale; // corner 3 distance from sideline
            
            // TOP END
            // Free throw semicircle (facing down toward basket)
            ctx.beginPath();
            ctx.arc(cx, cy - hl + ftDepth, ftWidth, 0, Math.PI);
            ctx.stroke();
            
            // Regulation 3-point arc (19'9" high school)
            const hsThreeRadius = 19.75 * scale; // High school 3-point distance
            ctx.beginPath();
            ctx.arc(cx, cy - hl + basketDist, hsThreeRadius, Math.asin(14/19.75), Math.PI - Math.asin(14/19.75));
            ctx.stroke();
            
            // 3-point corner lines (regulation 5'3" from corners)
            const cornerDist = 5.25 * scale;
            ctx.beginPath();
            ctx.moveTo(cx - hw + cornerDist, cy - hl);
            ctx.lineTo(cx - hw + cornerDist, cy - hl + basketDist - 6.25 * scale);
            ctx.moveTo(cx + hw - cornerDist, cy - hl);
            ctx.lineTo(cx + hw - cornerDist, cy - hl + basketDist - 6.25 * scale);
            ctx.stroke();
            
            // BOTTOM END
            // Free throw semicircle (facing up toward basket)
            ctx.beginPath();
            ctx.arc(cx, cy + hl - ftDepth, ftWidth, Math.PI, Math.PI * 2);
            ctx.stroke();
            
            // Regulation 3-point arc (19'9" high school)
            ctx.beginPath();
            ctx.arc(cx, cy + hl - basketDist, hsThreeRadius, Math.PI + Math.asin(14/19.75), -Math.asin(14/19.75));
            ctx.stroke();
            
            // 3-point corner lines (regulation 5'3" from corners)
            ctx.beginPath();
            ctx.moveTo(cx - hw + cornerDist, cy + hl);
            ctx.lineTo(cx - hw + cornerDist, cy + hl - basketDist + 6.25 * scale);
            ctx.moveTo(cx + hw - cornerDist, cy + hl);
            ctx.lineTo(cx + hw - cornerDist, cy + hl - basketDist + 6.25 * scale);
            ctx.stroke();
        } else if (state.sport === 'multi') {
            // Multi-sport: Pickleball court with basketball half-court from sideline
            const pbW = 10 * scale; // pickleball half-width (20ft total)
            const pbL = 22 * scale; // pickleball half-length (44ft total)  
            const kitchen = 7 * scale; // kitchen zone depth
            
            // Draw pickleball kitchen zones with different color
            ctx.fillStyle = state.kitchenColor;
            ctx.fillRect(cx - pbW, cy - kitchen, pbW * 2, kitchen); // top kitchen
            ctx.fillRect(cx - pbW, cy, pbW * 2, kitchen); // bottom kitchen
            
            // Add gritty texture to kitchen
            ctx.globalAlpha = 0.08;
            for (let i = 0; i < 120; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
                const size = Math.random() > 0.8 ? 2 : 1;
                ctx.fillRect(cx - pbW + Math.random() * pbW * 2, cy - kitchen + Math.random() * kitchen, size, size);
                ctx.fillRect(cx - pbW + Math.random() * pbW * 2, cy + Math.random() * kitchen, size, size);
            }
            ctx.globalAlpha = 1;
            
            // Pickleball lines (white)
            ctx.strokeStyle = state.lineColor;
            ctx.lineWidth = 3;
            
            // Outer pickleball boundary
            ctx.strokeRect(cx - pbW, cy - pbL, pbW * 2, pbL * 2);
            
            // Center line (net)
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(cx - pbW, cy);
            ctx.lineTo(cx + pbW, cy);
            ctx.stroke();
            
            // Kitchen lines
            ctx.lineWidth = 5;
            ctx.beginPath();
            ctx.moveTo(cx - pbW, cy - kitchen);
            ctx.lineTo(cx + pbW, cy - kitchen);
            ctx.moveTo(cx - pbW, cy + kitchen);
            ctx.lineTo(cx + pbW, cy + kitchen);
            ctx.stroke();
            
            // Centerlines in service areas
            ctx.beginPath();
            ctx.moveTo(cx, cy - pbL);
            ctx.lineTo(cx, cy - kitchen);
            ctx.moveTo(cx, cy + pbL);
            ctx.lineTo(cx, cy + kitchen);
            ctx.stroke();
            
            // Basketball half-court centered with pickleball court
            ctx.strokeStyle = state.bballLineColor;
            ctx.lineWidth = 4;
            
            const basketX = offX; // Basket at left edge so 3-point arc starts from canvas edge
            const threeRadius = 23.75 * scale; // 3-point arc radius  
            const ftDistance = 15 * scale; // Free throw line distance from basket
            
            // 3-point arc (half circle, extends to near canvas edges)
            ctx.beginPath();
            ctx.arc(basketX, cy, threeRadius, -Math.PI * 0.5, Math.PI * 0.5);
            ctx.stroke();
            
            // Free throw line (vertical line at proper distance from basket)
            ctx.beginPath();
            ctx.moveTo(basketX + ftDistance, cy - 6 * scale);
            ctx.lineTo(basketX + ftDistance, cy + 6 * scale);
            ctx.stroke();
        }
        
        // Draw logo in bottom left
        if (logoImg.complete && logoImg.naturalWidth > 0) {
            const logoHeight = 35;
            const logoWidth = (logoImg.naturalWidth / logoImg.naturalHeight) * logoHeight;
            ctx.globalAlpha = 0.85;
            ctx.drawImage(logoImg, 15, canvas.height - logoHeight - 12, logoWidth, logoHeight);
            ctx.globalAlpha = 1;
        }
        
        // URL in bottom right
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.font = 'bold 13px Inter, sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText('precisionprocourts.com', canvas.width - 15, canvas.height - 18);
    }
    
    // Initialize
    updateColorRowVisibility();
    drawCourt();
</script>