    /* Hide kitchen row by default, show only for pickleball/multi */
    .color-row.kitchen-row { display: none; }
    .color-row.kitchen-row.show { display: flex; }
    
    /* Hide basketball lines row by default, show only for multi-sport */
    .color-row.bball-lines-row { display: none; }
