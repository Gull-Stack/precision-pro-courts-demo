    .color-section { margin-bottom: 1rem; }
    .color-row { 
        display: flex; 
        align-items: center; 
        gap: 0.75rem; 
        margin-bottom: 0.75rem;
        padding: 0.5rem;
        border-radius: 8px;
        transition: background 0.2s;
        cursor: pointer;
