        popular: { play: '#1A3366', kitchen: '#1A3366', surround: '#5A6A72', line: '#ffffff', bballLine: '#8C8E8E', playName: 'Competition Blue', kitchenName: 'Competition Blue', surroundName: 'Slate', bballLineName: 'Grey' },
    };
    
    const COURT_DIMS = {
        tennis: { courtW: 36, courtL: 78, totalW: 60, totalL: 120 },
        pickleball: { courtW: 20, courtL: 44, totalW: 34, totalL: 64 },
        basketball: { courtW: 50, courtL: 94, totalW: 60, totalL: 100 },
        multi: { courtW: 20, courtL: 44, totalW: 34, totalL: 54 }, // Pickleball + basketball overlay (no sidelines)
    };
    
    let state = {
        sport: 'tennis',
        playColor: '#1A3366',
        kitchenColor: '#1A3366',
        surroundColor: '#4A7B3F',
        lineColor: '#FFFFFF',
        bballLineColor: '#8C8E8E',
        activeColorTarget: null,
        equipment: { net: true, hoop: false, fence: false, lights: false, rebounder: false },
        hoopCount: 2
    };
    
    const canvas = document.getElementById('courtCanvas');
    const ctx = canvas.getContext('2d');
    
    // Preload logo for watermark
    const logoImg = new Image();
    logoImg.src = '/assets/images/logos/logo-white-lg.png';
    logoImg.onload = () => drawCourt(); // Redraw when logo loads
    
    const paletteGrid = document.getElementById('paletteGrid');
    COURT_COLORS.forEach((color) => {
        const swatch = document.createElement('div');
        swatch.className = 'swatch';
        swatch.style.background = color.hex;
        swatch.title = color.name;
        swatch.dataset.hex = color.hex;
        swatch.dataset.name = color.name;
        swatch.addEventListener('click', () => selectColor(color.hex, color.name));
        paletteGrid.appendChild(swatch);
    });
    
    function setColorTarget(target) {
        state.activeColorTarget = target;
        document.querySelectorAll('.color-row').forEach(el => el.classList.remove('active'));
        document.getElementById(target + 'Row').classList.add('active');
        
        // Show palette when a color is selected
        document.getElementById('paletteSection').classList.add('show');
    }
    
    function updateColorRowVisibility() {
        const kitchenRow = document.getElementById('kitchenRow');
        const bballLineRow = document.getElementById('bballLineRow');
        
        // Kitchen shows for pickleball and multi-sport
        if (state.sport === 'pickleball' || state.sport === 'multi') {
            kitchenRow.classList.add('show');
        } else {
            kitchenRow.classList.remove('show');
            if (state.activeColorTarget === 'kitchen') {
                state.activeColorTarget = null;
                kitchenRow.classList.remove('active');
                document.getElementById('paletteSection').classList.remove('show');
            }
        }
        
        // Basketball lines only shows for multi-sport
        if (state.sport === 'multi') {
            bballLineRow.classList.add('show');
        } else {
            bballLineRow.classList.remove('show');
            if (state.activeColorTarget === 'bballLine') {
                state.activeColorTarget = null;
                bballLineRow.classList.remove('active');
                document.getElementById('paletteSection').classList.remove('show');
            }
        }
    }
    
    function selectColor(hex, name) {
        if (!state.activeColorTarget) return; // Don't do anything if no target selected
        
        if (state.activeColorTarget === 'play') {
            state.playColor = hex;
            document.getElementById('playColor').style.background = hex;
            document.getElementById('playColorName').textContent = name;
        } else if (state.activeColorTarget === 'kitchen') {
            state.kitchenColor = hex;
            document.getElementById('kitchenColor').style.background = hex;
            document.getElementById('kitchenColorName').textContent = name;
        } else if (state.activeColorTarget === 'surround') {
            state.surroundColor = hex;
            document.getElementById('surroundColor').style.background = hex;
            document.getElementById('surroundColorName').textContent = name;
        } else if (state.activeColorTarget === 'line') {
            state.lineColor = hex;
            document.getElementById('lineColor').style.background = hex;
            document.getElementById('lineColorName').textContent = name;
        } else if (state.activeColorTarget === 'bballLine') {
            state.bballLineColor = hex;
            document.getElementById('bballLineColor').style.background = hex;
            document.getElementById('bballLineColorName').textContent = name;
        }
        
        drawCourt();
    }
    
    document.querySelectorAll('.sport-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.sport-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.sport = btn.dataset.sport;
            updateColorRowVisibility();
            updateEquipVisibility();
            drawCourt();
        });
    });
    
    document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const preset = PRESETS[btn.dataset.preset];
            state.playColor = preset.play;
            state.kitchenColor = preset.kitchen;
            state.surroundColor = preset.surround;
            state.lineColor = preset.line;
            state.bballLineColor = preset.bballLine;
            document.getElementById('playColor').style.background = preset.play;
            document.getElementById('kitchenColor').style.background = preset.kitchen;
            document.getElementById('surroundColor').style.background = preset.surround;
            document.getElementById('lineColor').style.background = preset.line;
            document.getElementById('bballLineColor').style.background = preset.bballLine;
            document.getElementById('playColorName').textContent = preset.playName;
            document.getElementById('kitchenColorName').textContent = preset.kitchenName;
            document.getElementById('surroundColorName').textContent = preset.surroundName;
            document.getElementById('lineColorName').textContent = 'White';
            document.getElementById('bballLineColorName').textContent = preset.bballLineName;
            drawCourt();
        });
    });
    
    // Equipment toggles
    document.querySelectorAll('.equip-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const key = btn.dataset.equip;
            state.equipment[key] = !state.equipment[key];
            btn.classList.toggle('active', state.equipment[key]);
            document.getElementById('hoopCountRow').classList.toggle('show', state.equipment.hoop);
            drawCourt();
            updateBuildSummary();
        });
    });

    document.querySelectorAll('.subopt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.subopt-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.hoopCount = parseInt(btn.dataset.hoopcount, 10);
            drawCourt();
            updateBuildSummary();
        });
    });

    const EQUIP_LABELS = { net: 'Net', hoop: 'Basketball hoop', fence: 'Fencing', lights: 'Lights', rebounder: 'Rebound wall' };
    // Net and rebound wall don't apply to a basketball-only court
    function equipApplies(k) {
        if ((k === 'net' || k === 'rebounder') && state.sport === 'basketball') return false;
        return true;
    }
    function activeEquipment() {
        return Object.keys(state.equipment).filter(k => state.equipment[k] && equipApplies(k));
    }
    function updateEquipVisibility() {
        document.querySelectorAll('.equip-btn').forEach(b => {
            b.style.display = equipApplies(b.dataset.equip) ? '' : 'none';
        });
    }
    function updateBuildSummary() {
        const sportName = { pickleball: 'Pickleball', tennis: 'Tennis', basketball: 'Basketball', multi: 'Multi-Sport' }[state.sport];
        document.getElementById('sumSport').textContent = sportName;
        document.getElementById('sumPlay').textContent = document.getElementById('playColorName').textContent;
        document.getElementById('sumSurround').textContent = document.getElementById('surroundColorName').textContent;
        const wrap = document.getElementById('sumEquip');
        wrap.innerHTML = '';
        const on = activeEquipment();
        if (!on.length) {
            wrap.innerHTML = '<span class="chip none">None yet</span>';
        } else {
            on.forEach(k => {
                let label = EQUIP_LABELS[k];
                if (k === 'hoop') label += state.hoopCount === 2 ? ' ×2' : ' ×1';
                const chip = document.createElement('span');
                chip.className = 'chip';
                chip.textContent = label;
                wrap.appendChild(chip);
            });
        }
    }

    document.getElementById('downloadBtn').addEventListener('click', () => {
        const link = document.createElement('a');
        link.download = `precision-pro-courts-${state.sport}-design.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
    });
    
    // Share button functionality
    document.getElementById('shareBtn').addEventListener('click', async () => {
        try {
            canvas.toBlob(async (blob) => {
                const file = new File([blob], `precision-pro-courts-${state.sport}-design.png`, { type: 'image/png' });
                
                if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                    // Use native sharing if available (mobile)
                    await navigator.share({
                        title: 'My Custom Court Design',
                        text: `Check out my custom ${state.sport} court design from Precision Pro Courts!`,
                        files: [file]
                    });
                } else {
                    // Fallback: Copy image to clipboard
                    if (navigator.clipboard && window.ClipboardItem) {
                        const item = new ClipboardItem({ 'image/png': blob });
                        await navigator.clipboard.write([item]);
                        
                        // Show feedback
                        const shareBtn = document.getElementById('shareBtn');
                        const originalText = shareBtn.innerHTML;
                        shareBtn.innerHTML = '<span>✅</span> Copied!';
                        shareBtn.style.background = '#22c55e';
                        setTimeout(() => {
                            shareBtn.innerHTML = originalText;
                            shareBtn.style.background = '';
                        }, 2000);
                    } else {
                        // Final fallback: Download
                        const link = document.createElement('a');
                        link.download = `precision-pro-courts-${state.sport}-design.png`;
                        link.href = canvas.toDataURL('image/png');
                        link.click();
                    }
                }
            }, 'image/png');
        } catch (error) {
            console.error('Share failed:', error);
            // Fallback to download
            const link = document.createElement('a');
            link.download = `precision-pro-courts-${state.sport}-design.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
        }
    });
    
    function drawCourt() {
        const dims = COURT_DIMS[state.sport];
        
        // Fixed canvas size to fill the preview area consistently (2x size)
        const maxWidth = 700;
        const maxHeight = 900;
        
        // Calculate scale to fit court while maximizing space
        const scaleByWidth = maxWidth / dims.totalW;
        const scaleByHeight = maxHeight / dims.totalL;
        const scale = Math.min(scaleByWidth, scaleByHeight);
        
        // Size canvas to exactly fit the court (no extra padding)
        canvas.width = dims.totalW * scale;
        canvas.height = dims.totalL * scale;
        
        const offX = 0;
        const offY = 0;
        
        // Fill entire canvas with surround color - no dark blue background
        ctx.fillStyle = state.surroundColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Subtle texture on surround
        ctx.globalAlpha = 0.03;
        for (let i = 0; i < 500; i++) {
            ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
            ctx.fillRect(Math.random() * canvas.width, Math.random() * canvas.height, 1, 1);
        }
        ctx.globalAlpha = 1;
        
        const courtOffX = offX + ((dims.totalW - dims.courtW) / 2) * scale;
        const courtOffY = offY + ((dims.totalL - dims.courtL) / 2) * scale;
        ctx.fillStyle = state.playColor;
        ctx.fillRect(courtOffX, courtOffY, dims.courtW * scale, dims.courtL * scale);
        
        ctx.globalAlpha = 0.03;
        for (let i = 0; i < 300; i++) {
            ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
            ctx.fillRect(courtOffX + Math.random() * dims.courtW * scale, courtOffY + Math.random() * dims.courtL * scale, 1, 1);
        }
        ctx.globalAlpha = 1;
        
        ctx.strokeStyle = state.lineColor;
        ctx.lineWidth = 5;
        ctx.lineCap = 'round';
        
        const cx = canvas.width / 2;
        const cy = canvas.height / 2;
        const hw = (dims.courtW * scale) / 2;
        const hl = (dims.courtL * scale) / 2;
        
        ctx.strokeRect(courtOffX, courtOffY, dims.courtW * scale, dims.courtL * scale);
        
        if (state.sport === 'tennis') {
            const singlesW = (27 * scale) / 2;
            const serviceDist = 21 * scale;
            ctx.beginPath();
            ctx.moveTo(cx - singlesW, cy - hl);
            ctx.lineTo(cx - singlesW, cy + hl);
            ctx.moveTo(cx + singlesW, cy - hl);
            ctx.lineTo(cx + singlesW, cy + hl);
            ctx.stroke();
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(cx - singlesW, cy - serviceDist);
            ctx.lineTo(cx + singlesW, cy - serviceDist);
            ctx.moveTo(cx - singlesW, cy + serviceDist);
            ctx.lineTo(cx + singlesW, cy + serviceDist);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - serviceDist);
            ctx.lineTo(cx, cy + serviceDist);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - hl);
            ctx.lineTo(cx, cy - hl + 8);
            ctx.moveTo(cx, cy + hl);
            ctx.lineTo(cx, cy + hl - 8);
            ctx.stroke();
        } else if (state.sport === 'pickleball') {
            const kitchen = 7 * scale;
            
            // Fill kitchen zones (non-volley zones) with kitchen color
            ctx.fillStyle = state.kitchenColor;
            ctx.fillRect(cx - hw, cy - kitchen, hw * 2, kitchen); // top kitchen
            ctx.fillRect(cx - hw, cy, hw * 2, kitchen); // bottom kitchen
            
            // Add texture to kitchen
            ctx.globalAlpha = 0.03;
            for (let i = 0; i < 100; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
                ctx.fillRect(cx - hw + Math.random() * hw * 2, cy - kitchen + Math.random() * kitchen, 1, 1);
                ctx.fillRect(cx - hw + Math.random() * hw * 2, cy + Math.random() * kitchen, 1, 1);
            }
            ctx.globalAlpha = 1;
            
            ctx.strokeStyle = state.lineColor;
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy - kitchen);
            ctx.lineTo(cx + hw, cy - kitchen);
            ctx.moveTo(cx - hw, cy + kitchen);
            ctx.lineTo(cx + hw, cy + kitchen);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx, cy - hl);
            ctx.lineTo(cx, cy - kitchen);
            ctx.moveTo(cx, cy + hl);
            ctx.lineTo(cx, cy + kitchen);
            ctx.stroke();
        } else if (state.sport === 'basketball') {
            // Center circle
            ctx.beginPath();
            ctx.arc(cx, cy, 6 * scale, 0, Math.PI * 2);
            ctx.stroke();
            
            // Half court line
            ctx.beginPath();
            ctx.moveTo(cx - hw, cy);
            ctx.lineTo(cx + hw, cy);
            ctx.stroke();
            
            const ftWidth = 6 * scale; // half of 12ft lane width
            const ftDepth = 19 * scale; // 19ft from baseline
            const basketDist = 5.25 * scale; // basket center from baseline
            const threeRadius = 23.75 * scale; // 3pt arc radius
            const threeCornerDist = 3 * scale; // corner 3 distance from sideline
            
            // TOP END
            // Free throw lane (key)
            ctx.strokeRect(cx - ftWidth, cy - hl, ftWidth * 2, ftDepth);
            
            // Free throw semicircle (facing down toward basket)
            ctx.beginPath();
            ctx.arc(cx, cy - hl + ftDepth, ftWidth, 0, Math.PI);
            ctx.stroke();
            
            // 3-point arc (facing down)
            ctx.beginPath();
            ctx.arc(cx, cy - hl + basketDist, threeRadius, 0.41, Math.PI - 0.41);
            ctx.stroke();
            
            // 3-point corner lines (connect sideline to arc)
            ctx.beginPath();
            ctx.moveTo(cx - hw + threeCornerDist, cy - hl);
            ctx.lineTo(cx - hw + threeCornerDist, cy - hl + 14 * scale);
            ctx.moveTo(cx + hw - threeCornerDist, cy - hl);
            ctx.lineTo(cx + hw - threeCornerDist, cy - hl + 14 * scale);
            ctx.stroke();
            
            // Restricted area (4ft radius facing down)
            ctx.beginPath();
            ctx.arc(cx, cy - hl + basketDist, 4 * scale, 0, Math.PI);
            ctx.stroke();
            
            // BOTTOM END
            // Free throw lane (key)
            ctx.strokeRect(cx - ftWidth, cy + hl - ftDepth, ftWidth * 2, ftDepth);
            
            // Free throw semicircle (facing up toward basket)
            ctx.beginPath();
            ctx.arc(cx, cy + hl - ftDepth, ftWidth, Math.PI, Math.PI * 2);
            ctx.stroke();
            
            // 3-point arc (facing up)
            ctx.beginPath();
            ctx.arc(cx, cy + hl - basketDist, threeRadius, Math.PI + 0.41, -0.41);
            ctx.stroke();
            
            // 3-point corner lines
            ctx.beginPath();
            ctx.moveTo(cx - hw + threeCornerDist, cy + hl);
            ctx.lineTo(cx - hw + threeCornerDist, cy + hl - 14 * scale);
            ctx.moveTo(cx + hw - threeCornerDist, cy + hl);
            ctx.lineTo(cx + hw - threeCornerDist, cy + hl - 14 * scale);
            ctx.stroke();
            
            // Restricted area (4ft radius facing up)
            ctx.beginPath();
            ctx.arc(cx, cy + hl - basketDist, 4 * scale, Math.PI, Math.PI * 2);
            ctx.stroke();
        } else if (state.sport === 'multi') {
            // Multi-sport: Pickleball court with basketball half-court from sideline
            const pbW = 10 * scale; // pickleball half-width (20ft total)
            const pbL = 22 * scale; // pickleball half-length (44ft total)  
            const kitchen = 7 * scale; // kitchen zone depth
            
            // Draw pickleball kitchen zones with different color
            ctx.fillStyle = state.kitchenColor;
            ctx.fillRect(cx - pbW, cy - kitchen, pbW * 2, kitchen); // top kitchen
            ctx.fillRect(cx - pbW, cy, pbW * 2, kitchen); // bottom kitchen
            
            // Add texture to kitchen
            ctx.globalAlpha = 0.03;
            for (let i = 0; i < 80; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? '#ffffff' : '#000000';
                ctx.fillRect(cx - pbW + Math.random() * pbW * 2, cy - kitchen + Math.random() * kitchen, 1, 1);
                ctx.fillRect(cx - pbW + Math.random() * pbW * 2, cy + Math.random() * kitchen, 1, 1);
            }
            ctx.globalAlpha = 1;
            
            // Pickleball lines (white)
            ctx.strokeStyle = state.lineColor;
            ctx.lineWidth = 3;
            
            // Outer pickleball boundary
            ctx.strokeRect(cx - pbW, cy - pbL, pbW * 2, pbL * 2);
            
            // Center line (net)
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(cx - pbW, cy);
            ctx.lineTo(cx + pbW, cy);
            ctx.stroke();
            
            // Kitchen lines
            ctx.lineWidth = 5;
            ctx.beginPath();
            ctx.moveTo(cx - pbW, cy - kitchen);
            ctx.lineTo(cx + pbW, cy - kitchen);
            ctx.moveTo(cx - pbW, cy + kitchen);
            ctx.lineTo(cx + pbW, cy + kitchen);
            ctx.stroke();
            
            // Centerlines in service areas
            ctx.beginPath();
            ctx.moveTo(cx, cy - pbL);
            ctx.lineTo(cx, cy - kitchen);
            ctx.moveTo(cx, cy + pbL);
            ctx.lineTo(cx, cy + kitchen);
            ctx.stroke();
            
            // Basketball half-court from LEFT sideline (shifted right 35%)
            ctx.strokeStyle = state.bballLineColor;
            ctx.lineWidth = 4;
            
            const courtWidth = (offX + hw) - offX; // Total court width
            const rightShift = 0; // Basket at left edge of canvas
            const basketX = offX + rightShift; // Basket shifted 35% from left edge
            const threeRadius = 23.75 * scale; // 3-point arc radius
            const ftDistance = 15 * scale; // Free throw line distance from basket
            
            // 3-point arc (half circle, shifted right)
            ctx.beginPath();
            ctx.arc(basketX, cy, threeRadius, -Math.PI * 0.5, Math.PI * 0.5);
            ctx.stroke();
            
            // Free throw line (vertical line, shifted right)
            ctx.beginPath();
            ctx.moveTo(basketX + ftDistance, cy - 6 * scale);
            ctx.lineTo(basketX + ftDistance, cy + 6 * scale);
            ctx.stroke();
        }
        
        // Draw equipment / build-out add-ons on top of the court
        drawEquipment(scale, cx, cy, hw, hl, courtOffX, courtOffY);

        // Draw logo in bottom left
        if (logoImg.complete && logoImg.naturalWidth > 0) {
            const logoHeight = 35;
            const logoWidth = (logoImg.naturalWidth / logoImg.naturalHeight) * logoHeight;
            ctx.globalAlpha = 0.85;
            ctx.drawImage(logoImg, 15, canvas.height - logoHeight - 12, logoWidth, logoHeight);
            ctx.globalAlpha = 1;
        }
        
        // URL in bottom right
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.font = 'bold 13px Inter, sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText('precisionprocourts.com', canvas.width - 15, canvas.height - 18);

        if (typeof updateBuildSummary === 'function') updateBuildSummary();
    }

    // ===== Equipment / build-out renderer (top-down) =====
    function drawEquipment(scale, cx, cy, hw, hl, courtOffX, courtOffY) {
        const W = canvas.width, H = canvas.height;
        const eq = state.equipment;
        const margin = Math.max(5, W * 0.02);

        // --- Lights: warm glow pools + poles at the four corners ---
        if (eq.lights) {
            const r = Math.min(W, H) * 0.34;
            const corners = [[margin, margin], [W - margin, margin], [margin, H - margin], [W - margin, H - margin]];
            corners.forEach(([x, y]) => {
                const g = ctx.createRadialGradient(x, y, 0, x, y, r);
                g.addColorStop(0, 'rgba(255,246,196,0.40)');
                g.addColorStop(0.5, 'rgba(255,240,170,0.14)');
                g.addColorStop(1, 'rgba(255,240,170,0)');
                ctx.fillStyle = g;
                ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
            });
        }

        // --- Fencing: perimeter rail + posts (chain-link read) ---
        if (eq.fence) {
            ctx.save();
            const x = margin, y = margin, w = W - margin * 2, h = H - margin * 2;
            // mesh (faint inner dashes)
            ctx.strokeStyle = 'rgba(210,214,220,0.28)';
            ctx.lineWidth = Math.max(1, W * 0.0025);
            ctx.setLineDash([3, 3]);
            ctx.strokeRect(x, y, w, h);
            // top rail
            ctx.setLineDash([]);
            ctx.strokeStyle = 'rgba(38,42,50,0.92)';
            ctx.lineWidth = Math.max(2, W * 0.006);
            ctx.strokeRect(x, y, w, h);
            // posts
            ctx.fillStyle = '#23272e';
            const postR = Math.max(2.5, W * 0.009);
            const nx = 4, ny = 6;
            for (let i = 0; i <= nx; i++) {
                const px = x + (w * i) / nx;
                ctx.beginPath(); ctx.arc(px, y, postR, 0, Math.PI * 2); ctx.fill();
                ctx.beginPath(); ctx.arc(px, y + h, postR, 0, Math.PI * 2); ctx.fill();
            }
            for (let i = 1; i < ny; i++) {
                const py = y + (h * i) / ny;
                ctx.beginPath(); ctx.arc(x, py, postR, 0, Math.PI * 2); ctx.fill();
                ctx.beginPath(); ctx.arc(x + w, py, postR, 0, Math.PI * 2); ctx.fill();
            }
            ctx.restore();
        }

        // --- Rebound wall: slatted wall just outside the top baseline ---
        if (eq.rebounder && state.sport !== 'basketball') {
            const wallH = 1.6 * scale;
            const y = courtOffY - wallH - 2;
            const x0 = cx - hw, wWidth = hw * 2;
            ctx.save();
            ctx.fillStyle = '#1f3d2b';
            ctx.fillRect(x0, y, wWidth, wallH);
            ctx.strokeStyle = 'rgba(255,255,255,0.18)';
            ctx.lineWidth = 1;
            const slats = 10;
            for (let i = 1; i < slats; i++) {
                const sx = x0 + (wWidth * i) / slats;
                ctx.beginPath(); ctx.moveTo(sx, y); ctx.lineTo(sx, y + wallH); ctx.stroke();
            }
            ctx.strokeStyle = 'rgba(0,0,0,0.35)';
            ctx.strokeRect(x0, y, wWidth, wallH);
            ctx.restore();
        }

        // --- Net: mesh band across the center (racket/paddle sports) ---
        if (eq.net && state.sport !== 'basketball') {
            const ext = 1.0 * scale;               // posts a touch beyond sidelines
            const x0 = cx - hw - ext, x1 = cx + hw + ext;
            const bandH = Math.max(6, 0.9 * scale);
            const yTop = cy - bandH / 2;
            ctx.save();
            // soft shadow band
            ctx.fillStyle = 'rgba(15,15,15,0.16)';
            ctx.fillRect(x0, yTop, x1 - x0, bandH);
            // mesh
            ctx.strokeStyle = 'rgba(255,255,255,0.75)';
            ctx.lineWidth = 1;
            for (let x = x0; x <= x1; x += 4) {
                ctx.beginPath(); ctx.moveTo(x, yTop); ctx.lineTo(x, yTop + bandH); ctx.stroke();
            }
            // tape (top/bottom)
            ctx.strokeStyle = 'rgba(20,20,20,0.65)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(x0, yTop); ctx.lineTo(x1, yTop);
            ctx.moveTo(x0, yTop + bandH); ctx.lineTo(x1, yTop + bandH);
            ctx.stroke();
            // posts
            ctx.fillStyle = '#23272e';
            const postR = Math.max(3, 0.6 * scale);
            ctx.beginPath(); ctx.arc(x0, cy, postR, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(x1, cy, postR, 0, Math.PI * 2); ctx.fill();
            ctx.restore();
        }

        // --- Basketball hoop(s): top-down backboard + rim ---
        if (eq.hoop) {
            const bbHalf = 3 * scale;       // 6ft backboard
            const rimR = 0.9 * scale;
            const outside = 0.5 * scale;    // backboard sits just outside the baseline
            const rimOffset = 1.3 * scale;  // rim center inside the baseline

            const hoopH = (baseY, dir) => { // horizontal baseline; dir=+1 protrudes downward
                const backY = baseY - dir * outside;
                ctx.save();
                ctx.strokeStyle = '#eef0f3'; ctx.lineWidth = 4; ctx.lineCap = 'round';
                ctx.beginPath(); ctx.moveTo(cx - bbHalf, backY); ctx.lineTo(cx + bbHalf, backY); ctx.stroke();
                ctx.strokeStyle = '#ff6a00'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.arc(cx, baseY + dir * rimOffset, rimR, 0, Math.PI * 2); ctx.stroke();
                ctx.strokeStyle = 'rgba(255,106,0,0.7)'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.moveTo(cx, backY); ctx.lineTo(cx, baseY + dir * (rimOffset - rimR)); ctx.stroke();
                ctx.restore();
            };
            const hoopV = (baseX, dir) => { // vertical baseline (multi); dir=+1 protrudes right
                const backX = baseX - dir * outside;
                ctx.save();
                ctx.strokeStyle = '#eef0f3'; ctx.lineWidth = 4; ctx.lineCap = 'round';
                ctx.beginPath(); ctx.moveTo(backX, cy - bbHalf); ctx.lineTo(backX, cy + bbHalf); ctx.stroke();
                ctx.strokeStyle = '#ff6a00'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.arc(baseX + dir * rimOffset, cy, rimR, 0, Math.PI * 2); ctx.stroke();
                ctx.restore();
            };

            if (state.sport === 'multi') {
                hoopV(courtOffX, +1);                       // single hoop at the left baseline
            } else {
                hoopH(courtOffY, +1);                        // top baseline
                if (state.hoopCount === 2) hoopH(courtOffY + hl * 2, -1); // bottom baseline
            }
        }
    }

    // ===== Quote request: emails the full build spec + rendered design =====
    document.getElementById('quoteForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = document.getElementById('quoteSubmit');
        const statusEl = document.getElementById('quoteStatus');
        const original = btn.innerHTML;

        if (form.company.value) return; // honeypot tripped — silently ignore

        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span> Sending…';
        statusEl.className = 'quote-status';
        statusEl.textContent = '';

        const equipOn = activeEquipment();
        const design = {
            sport: document.getElementById('sumSport').textContent,
            playSurface: document.getElementById('playColorName').textContent,
            kitchen: document.getElementById('kitchenColorName').textContent,
            surround: document.getElementById('surroundColorName').textContent,
            lines: document.getElementById('lineColorName').textContent,
            addOns: equipOn.map(k => k === 'hoop' ? `${EQUIP_LABELS[k]} (${state.hoopCount === 2 ? 'both ends' : 'one end'})` : EQUIP_LABELS[k]),
        };

        try {
            const res = await fetch('/api/quote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: form.name.value,
                    email: form.email.value,
                    phone: form.phone.value,
                    zip: form.zip.value,
                    message: form.message.value,
                    design,
                    image: canvas.toDataURL('image/png'),
                }),
            });
            if (!res.ok) throw new Error('Request failed');
            statusEl.className = 'quote-status ok';
            statusEl.textContent = '✅ Sent! We\'ll be in touch within 24 hours with your quote.';
            form.reset();
            btn.innerHTML = '<span>✅</span> Design Sent!';
        } catch (err) {
            statusEl.className = 'quote-status err';
            statusEl.innerHTML = 'Something went wrong. Email us at <a href="mailto:team@precisionprocourts.com" style="color:#fca5a5;text-decoration:underline;">team@precisionprocourts.com</a> or call us.';
            btn.disabled = false;
            btn.innerHTML = original;
        }
    });

    // Initialize
    updateColorRowVisibility();
    updateEquipVisibility();
    drawCourt();
    updateBuildSummary();
</script>