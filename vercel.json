{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "precisionprocourts.com"
        }
      ],
      "destination": "https://www.precisionprocourts.com/:path*",
      "permanent": true
    },
    {
      "source": "/coatings",
      "destination": "/services/court-surfacing/",
      "permanent": true
    },
    {
      "source": "/coatings/",
      "destination": "/services/court-surfacing/",
      "permanent": true
    },
    {
      "source": "/services/coatings",
      "destination": "/services/court-surfacing/",
      "permanent": true
    },
    {
      "source": "/services/coatings/",
      "destination": "/services/court-surfacing/",
      "permanent": true
    },
    {
      "source": "/fencing",
      "destination": "/services/fencing",
      "permanent": true
    },
    {
      "source": "/fencing/",
      "destination": "/services/fencing/",
      "permanent": true
    },
    {
      "source": "/privacy-policy-2",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/privacy-policy-2/",
      "destination": "/privacy-policy/",
      "permanent": true
    }
  ]
}
